    </record>

    <!-- Management Skills -->
    <record id="skill_project_management" model="onboarding.skill">
        <field name="name">Project Management</field>
        <field name="skill_type">management</field>
    </record>

    <record id="skill_leadership" model="onboarding.skill">
        <field name="name">Leadership</field>
        <field name="skill_type">management</field>
    </record>

    <record id="skill_strategic_planning" model="onboarding.skill">
        <field name="name">Strategic Planning</field>
        <field name="skill_type">management</field>
    </record>

    <record id="skill_budget_management" model="onboarding.skill">
        <field name="name">Budget Management</field>
        <field name="skill_type">management</field>
    </record>

    <!-- Cognitive Skills -->
    <record id="skill_problem_solving" model="onboarding.skill">
        <field name="name">Problem Solving</field>
        <field name="skill_type">cognitive</field>
    </record>

    <record id="skill_analytical_thinking" model="onboarding.skill">
