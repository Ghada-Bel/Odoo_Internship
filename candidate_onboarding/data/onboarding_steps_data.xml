<odoo>
    <data noupdate="1">

        <!-- Default Onboarding Template -->
        <record id="default_template" model="onboarding.template">
            <field name="name">Default Candidate Onboarding</field>
            <field name="description">Standard onboarding process for candidates</field>
            <field name="active">True</field>
        </record>

        <!-- Step 1: Personal Information -->
        <record id="onboarding_step_personal_info" model="onboarding.step">
            <field name="name">Personal Information</field>
            <field name="sequence">1</field>
            <field name="template_id" ref="candidate_onboarding.default_template"/>
            <field name="view_id" ref="candidate_onboarding.personal_info_step"/>
        </record>

        <!-- Step 2: Additional Information -->
        <record id="onboarding_step_additional_info" model="onboarding.step">
            <field name="name">Additional Information</field>
            <field name="sequence">2</field>
            <field name="template_id" ref="candidate_onboarding.default_template"/>
            <field name="view_id" ref="candidate_onboarding.additional_info_step"/>
        </record>

        <!-- Step 3: Highest Qualification -->
        <record id="onboarding_step_highest_qualification" model="onboarding.step">
            <field name="name">Highest Qualification</field>
            <field name="sequence">3</field>
            <field name="template_id" ref="candidate_onboarding.default_template"/>
            <field name="view_id" ref="candidate_onboarding.highest_qualification_step"/>
        </record>

        <!-- Step 4: Other Qualifications -->
        <record id="onboarding_step_other_qualifications" model="onboarding.step">
            <field name="name">Other Qualifications</field>
            <field name="sequence">4</field>
            <field name="template_id" ref="candidate_onboarding.default_template"/>
            <field name="view_id" ref="candidate_onboarding.other_qualifications_step"/>
        </record>

        <!-- Step 5: Work Experience -->
        <record id="onboarding_step_work_experience" model="onboarding.step">
            <field name="name">Work Experience</field>
            <field name="sequence">5</field>
            <field name="template_id" ref="candidate_onboarding.default_template"/>
            <field name="view_id" ref="candidate_onboarding.work_experience_step"/>
        </record>

        <!-- Step 6: Skills -->
        <record id="onboarding_step_skills" model="onboarding.step">
            <field name="name">Skills</field>
            <field name="sequence">6</field>
            <field name="template_id" ref="candidate_onboarding.default_template"/>
            <field name="view_id" ref="candidate_onboarding.skills_step"/>
        </record>

        <!-- Step 7: Availability -->
        <record id="onboarding_step_availability" model="onboarding.step">
            <field name="name">Availability</field>
            <field name="sequence">7</field>
            <field name="template_id" ref="candidate_onboarding.default_template"/>
            <field name="view_id" ref="candidate_onboarding.availability_step"/>
        </record>

        <!-- Step 8: References -->
        <record id="onboarding_step_references" model="onboarding.step">
            <field name="name">References</field>
            <field name="sequence">8</field>
            <field name="template_id" ref="candidate_onboarding.default_template"/>
            <field name="view_id" ref="candidate_onboarding.references_step"/>
        </record>

        <!-- Step 9: Documents -->
        <record id="onboarding_step_documents" model="onboarding.step">
            <field name="name">Documents</field>
            <field name="sequence">9</field>
            <field name="template_id" ref="candidate_onboarding.default_template"/>
            <field name="view_id" ref="candidate_onboarding.documents_step"/>
        </record>

        <!-- Step 10: Review -->
        <record id="onboarding_step_review" model="onboarding.step">
            <field name="name">Review</field>
            <field name="sequence">10</field>
            <field name="template_id" ref="candidate_onboarding.default_template"/>
            <field name="view_id" ref="candidate_onboarding.review_step"/>
        </record>

    </data>
</odoo>
