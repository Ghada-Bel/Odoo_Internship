    </record>

    <record id="skill_reliability" model="onboarding.skill">
        <field name="name">Reliability</field>
        <field name="skill_type">personal</field>
    </record>

    <record id="skill_initiative" model="onboarding.skill">
        <field name="name">Initiative</field>
        <field name="skill_type">personal</field>
    </record>

    <record id="skill_creativity" model="onboarding.skill">
        <field name="name">Creativity</field>
        <field name="skill_type">personal</field>
    </record>
</odoo>
