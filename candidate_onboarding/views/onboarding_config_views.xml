<odoo>
    <!-- Step Form View -->
    <record id="view_onboarding_step_form" model="ir.ui.view">
        <field name="name">onboarding.step.form</field>
        <field name="model">onboarding.step</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="is_active"/>
                        <field name="required"/>
                        <field name="view_id" options="{'no_create': True}" domain="[('type','=','qweb')]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Template Form View (unchanged except cosmetic) -->
    <record id="view_onboarding_template_form" model="ir.ui.view">
        <field name="name">onboarding.template.form</field>
        <field name="model">onboarding.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Steps">
                            <field name="step_ids" mode="tree,form">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="is_active"/>
                                    <field name="required"/>
                                    <field name="view_id"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="sequence"/>
                                            <field name="is_active"/>
                                            <field name="required"/>
                                            <field name="view_id" domain="[('type','=','qweb')]"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open Onboarding Templates -->
    <record id="action_hr_onboarding_templates" model="ir.actions.act_window">
        <field name="name">Onboarding Templates</field>
        <field name="res_model">onboarding.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your onboarding process templates here.
            </p>
        </field>
    </record>

    <!-- Menu Structure -->
    <menuitem id="menu_hr_onboarding_root" name="Onboarding" parent="hr.menu_hr_root" sequence="20"/>
    <menuitem id="menu_hr_onboarding_templates" name="Templates" parent="menu_hr_onboarding_root"
              action="action_hr_onboarding_templates"/>
</odoo>
