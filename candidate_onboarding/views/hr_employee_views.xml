<odoo>
    <record id="view_employee_form_inherit_onboarding" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.onboarding</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="onboarding_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
