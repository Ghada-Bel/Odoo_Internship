<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="personal_info_step" name="Personal Information Step">
        <div class="step-content">
            <!-- Header -->
            <div class="row">
                <div class="col-12">
                    <h4 class="step-title">Personal Information</h4>
                    <p class="step-description">
                        Please provide your basic personal information. 
                        <span class="text-danger">*</span> indicates required fields.
                    </p>
                </div>
            </div>
            
            <!-- First Row: First Name and Last Name -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="first_name" class="form-label">First Name <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input type="text" 
                               class="form-control" 
                               id="first_name" 
                               name="first_name" 
                               placeholder="Fadwa"
                               t-att-value="onboarding.first_name or ''" 
                               required="required"/>
                    </div>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label for="last_name" class="form-label">Last Name <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input type="text" 
                               class="form-control" 
                               id="last_name" 
                               name="last_name" 
                               placeholder="Hosni"
                               t-att-value="onboarding.last_name or ''" 
                               required="required"/>
                    </div>
                </div>
            </div>
            
            <!-- Second Row: ID Number and (optional) Email -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="id_number" class="form-label">ID Number <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                        <input type="text" 
                               class="form-control" 
                               id="id_number" 
                               name="id_number" 
                               placeholder="42-210739 1 42"
                               t-att-value="onboarding.id_number or ''" 
                               required="required"/>
                    </div>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email" 
                               class="form-control" 
                               id="email" 
                               name="email" 
                               placeholder="name@example.com"/>
                    </div>
                </div>
            </div>
            
            <!-- Third Row: Gender and Date of Birth -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="gender" class="form-label">Gender <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-venus-mars"></i></span>
                        <select class="form-select" id="gender" name="gender" required="required">
                            <option value="">Select Gender</option>
                            <option value="male" t-att-selected="onboarding.gender == 'male'">Male</option>
                            <option value="female" t-att-selected="onboarding.gender == 'female'">Female</option>
                            <option value="other" t-att-selected="onboarding.gender == 'other'">Other</option>
                        </select>
                    </div>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label for="birth_date" class="form-label">Date of Birth <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                        <input type="date" 
                               class="form-control" 
                               id="birth_date" 
                               name="birth_date"
                               t-att-value="onboarding.birth_date or ''" 
                               required="required"/>
                    </div>
                </div>
            </div>
            
            <!-- Fourth Row: Marital Status and Number of Dependents -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="marital_status" class="form-label">Marital Status <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-heart"></i></span>
                        <select class="form-select" id="marital_status" name="marital_status" required="required">
                            <option value="">Select Status</option>
                            <option value="single" t-att-selected="onboarding.marital_status == 'single'">Single</option>
                            <option value="married" t-att-selected="onboarding.marital_status == 'married'">Married</option>
                            <option value="divorced" t-att-selected="onboarding.marital_status == 'divorced'">Divorced</option>
                            <option value="widowed" t-att-selected="onboarding.marital_status == 'widowed'">Widowed</option>
                        </select>
                    </div>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label for="dependents" class="form-label">Number of Dependents <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-users"></i></span>
                        <input type="number" 
                               class="form-control" 
                               id="dependents" 
                               name="dependents" 
                               placeholder="2"
                               min="0"
                               t-att-value="onboarding.dependents or 0" 
                               required="required"/>
                    </div>
                </div>
            </div>
            
            <!-- Navigation Buttons -->
            <div class="navigation-buttons d-flex justify-content-end">
                <button type="submit" name="next_step" value="1" class="btn btn-primary">
                    Save &amp; Continue <i class="fas fa-arrow-right ms-2"></i>
                </button>
            </div>
        </div>
    </template>
</odoo>
