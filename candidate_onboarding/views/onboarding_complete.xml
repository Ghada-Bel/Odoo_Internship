<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="onboarding_complete" name="Onboarding Complete">
        <t t-call="website.layout">
            <t t-set="title">Application Submitted</t>
            <div class="container-fluid bg-light min-vh-100 py-4">
                <div class="container">
                    <!-- Header -->
                    <div class="row mb-4">
                        <div class="col-12 text-center">
                            <div class="mb-4">
                                <i class="fa fa-check-circle text-success" style="font-size: 4rem;"></i>
                            </div>
                            <h1 class="text-success mb-3">Application Submitted Successfully!</h1>
                            <p class="lead text-muted">Thank you for completing your onboarding application.</p>
                        </div>
                    </div>

                    <!-- Success Message Card -->
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6">
                            <div class="card shadow-sm">
                                <div class="card-body text-center p-5">
                                    <h4 class="mb-4">What happens next?</h4>
                                    <div class="row">
                                        <div class="col-12 mb-4">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3">
                                                    <i class="fa fa-eye text-primary" style="font-size: 1.5rem;"></i>
                                                </div>
                                                <div class="text-start">
                                                    <h6 class="mb-1">Application Review</h6>
                                                    <small class="text-muted">Our HR team will review your application within 5-7 business days.</small>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="col-12 mb-4">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3">
                                                    <i class="fa fa-phone text-success" style="font-size: 1.5rem;"></i>
                                                </div>
                                                <div class="text-start">
                                                    <h6 class="mb-1">Contact</h6>
                                                    <small class="text-muted">We'll contact you via email or phone for the next steps.</small>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="col-12 mb-4">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3">
                                                    <i class="fa fa-calendar text-info" style="font-size: 1.5rem;"></i>
                                                </div>
                                                <div class="text-start">
                                                    <h6 class="mb-1">Interview</h6>
                                                    <small class="text-muted">If selected, we'll schedule an interview at your convenience.</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <hr class="my-4"/>
                                    
                                    <div class="alert alert-info">
                                        <h6><i class="fa fa-info-circle me-2"></i>Application Details:</h6>
                                        <p class="mb-1"><strong>Applicant:</strong> <t t-esc="onboarding.first_name"/> <t t-esc="onboarding.surname"/></p>
                                        <p class="mb-1"><strong>Email:</strong> <t t-esc="onboarding.email"/></p>
                                        <p class="mb-0"><strong>Submitted:</strong> <t t-esc="onboarding.completion_date.strftime('%B %d, %Y at %I:%M %p') if onboarding.completion_date else 'Just now'"/></p>
                                    </div>
                                    
                                    <div class="mt-4">
                                        <a href="/web" class="btn btn-primary me-2">
                                            <i class="fa fa-home me-2"></i>Go to Dashboard
                                        </a>
                                        <a href="/web/session/logout" class="btn btn-outline-secondary">
                                            <i class="fa fa-sign-out me-2"></i>Logout
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Contact Information -->
                    <div class="row mt-5">
                        <div class="col-12 text-center">
                            <h5 class="mb-3">Need Help?</h5>
                            <p class="text-muted">If you have any questions about your application, please contact our HR department:</p>
                            <p>
                                <i class="fa fa-envelope me-2"></i>hr@cgmis.com | 
                                <i class="fa fa-phone me-2"></i>+263 xxx xxx xxx
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
