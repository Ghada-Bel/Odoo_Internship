<odoo>
  <template id="verify_template" name="Verify Email">
    <t t-call="website.layout">
      <div class="container mt-5" style="max-width: 500px;">
        <h3 class="mb-3">Email Verification</h3>
        <form action="/candidate/verify" method="POST">
          <input type="hidden" name="email" t-att-value="request.params.get('email')"/>
          <div class="form-group">
            <label>Enter Verification Code</label>
            <input type="text" name="code" class="form-control" required="required"/>
          </div>
          <button type="submit" class="btn btn-primary mt-2">Verify</button>
        </form>
      </div>
    </t>
  </template>
</odoo>
