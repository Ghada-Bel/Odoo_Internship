<odoo>
  <!-- Extend the default header -->
  <template id="custom_navbar" inherit_id="website.layout" name="Custom Navbar">
    <xpath expr="//header" position="replace">
      <header id="custom-navbar" class="navbar navbar-expand-lg navbar-light bg-light shadow-sm px-3">
        <div class="container">
          <a class="navbar-brand" href="/">
            <img src="/web/image/res.company/1/logo" height="40" alt="Logo"/>
          </a>
          <nav class="navbar-nav ms-auto">
            <a class="nav-link" href="/">Home</a>
            <a class="nav-link" href="/contactus">Contact Us</a>
            <a class="nav-link btn btn-outline-primary ms-3" href="/web/login">Login</a>
          </nav>
        </div>
      </header>
    </xpath>
  </template>

  <!-- Extend the footer if you want a custom footer as well -->
  <template id="custom_footer" inherit_id="website.layout">
    <xpath expr="//footer" position="replace">
      <footer class="bg-dark text-white text-center p-4 mt-5">
        <div class="container">
          <p class="mb-0">© 2025 CG MIS . All rights reserved.</p>
        </div>
      </footer>
    </xpath>
  </template>
</odoo>
